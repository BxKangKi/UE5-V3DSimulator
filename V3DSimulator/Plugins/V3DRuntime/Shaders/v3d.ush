// SPDX-License-Identifier: MIT
// V3D terrain shading contract, revision 1.
// Engine-independent HLSL (pixel stage, Shader Model 5 or equivalent).
// Unreal includes the byte-identical v3d.ush alias generated by V3DSimulator.Build.cs.
// Each texture is a Texture2DArray with FOUR equally sized slices. Source factors
// are already baked into the pixels. Base color/emissive use their declared sRGB
// view; normals and ORM MUST use a linear view. Normal pixels contain RGB UNORM
// tangent-space normals (not BC5, DXT5nm, or Unreal's unpacked Normal sampler).
// Vertex RGBA stores layer WEIGHTS, never an interpolated material index.
#ifndef V3D_TERRAIN_HLSL_INCLUDED
#define V3D_TERRAIN_HLSL_INCLUDED

float4 V3D_NormalizeTerrainWeights(float4 VertexWeights)
{
    float4 W = max(VertexWeights, 0.0);
    float Sum = dot(W, float4(1.0, 1.0, 1.0, 1.0));
    return Sum > 1.0e-6 ? W / max(Sum, 1.0e-6) : float4(1.0, 0.0, 0.0, 0.0);
}

float3 V3D_NormalizeTerrainNormal(float3 N)
{
    float LengthSquared = dot(N, N);
    return LengthSquared > 1.0e-8
        ? N * rsqrt(max(LengthSquared, 1.0e-8)) : float3(0.0, 0.0, 1.0);
}

// Useful for previewing baked RGBA weights. Alpha is layer 3, not opacity.
float3 V3D_TerrainWeightDebug(float4 VertexWeights)
{
    float4 W = V3D_NormalizeTerrainWeights(VertexWeights);
    return W.rgb + W.a * float3(1.0, 1.0, 0.0);
}

// Returns linear base color. Additional outputs: tangent-space normal,
// ORM=(occlusion, roughness, metallic), and linear emissive color.
// Pass the texture object's generated sampler explicitly from a UE Custom node.
// Pixel-only: UV derivatives give every array slice consistent mip selection.
// Do not call this function from World Position Offset or a vertex shader.
float4x3 V3D_SampleTerrain(
    Texture2DArray BaseColorArray, SamplerState BaseColorArraySampler,
    Texture2DArray NormalArray, SamplerState NormalArraySampler,
    Texture2DArray ORMArray, SamplerState ORMArraySampler,
    Texture2DArray EmissiveArray, SamplerState EmissiveArraySampler,
    float2 UV, float4 VertexWeights)
{
    float4 W = V3D_NormalizeTerrainWeights(VertexWeights);
    float2 DdxUV = ddx(UV);
    float2 DdyUV = ddy(UV);
    float3 BaseColor = float3(0.0, 0.0, 0.0);
    float3 NormalSum = float3(0.0, 0.0, 0.0);
    float3 ORM = float3(0.0, 0.0, 0.0);
    float3 Emissive = float3(0.0, 0.0, 0.0);

    // Always sample all four layers. No divergent derivative-dependent sampling
    // is introduced by weight boundaries; zero-weight layers contribute zero.
    [unroll]
    for (int Layer = 0; Layer < 4; ++Layer)
    {
        float3 UVLayer = float3(UV, float(Layer));
        float Weight = W[Layer];
        BaseColor += Weight * BaseColorArray.SampleGrad(
            BaseColorArraySampler, UVLayer, DdxUV, DdyUV).rgb;
        float3 N = NormalArray.SampleGrad(
            NormalArraySampler, UVLayer, DdxUV, DdyUV).xyz * 2.0 - 1.0;
        NormalSum += Weight * V3D_NormalizeTerrainNormal(N);
        ORM += Weight * ORMArray.SampleGrad(
            ORMArraySampler, UVLayer, DdxUV, DdyUV).rgb;
        Emissive += Weight * EmissiveArray.SampleGrad(
            EmissiveArraySampler, UVLayer, DdxUV, DdyUV).rgb;
    }

    float3 NormalTS = V3D_NormalizeTerrainNormal(NormalSum);
    ORM = saturate(ORM);
    float4x3 Result;
    Result[0] = max(BaseColor, 0.0);
    Result[1] = NormalTS;
    Result[2] = ORM;
    Result[3] = Emissive;
    return Result;
    //return max(BaseColor, 0.0);
}

#endif // V3D_TERRAIN_HLSL_INCLUDED

// ============================================================================
// Copyright © 2026 BxKangKi. Licensed under the MIT License.
// V3D Octahedral Impostor HLSL library.
// Mapped to /V3D/v3d.ush by V3DRuntimeModule.
// Supports both Texture2DArray (Slice 0 = BaseColor+Alpha, Slice 1 = WorldNormal+Roughness)
// and separate Texture2D atlas fallback.
#ifndef V3D_IMPOSTOR_HLSL_INCLUDED
#define V3D_IMPOSTOR_HLSL_INCLUDED

// Encodes any 3D unit direction vector into full-sphere octahedral UV coordinates in [0, 1]^2.
// Handles arbitrary 90/180-deg X/Y/Z node rotations and mirrored instances without hemisphere clamping.
float2 V3D_DirToHemiOctahedron(float3 Dir)
{
    float LenSq = dot(Dir, Dir);
    float3 N = LenSq > 1.0e-8 ? Dir * rsqrt(LenSq) : float3(0.0, 0.0, 1.0);
    float L1 = abs(N.x) + abs(N.y) + abs(N.z);
    N /= max(L1, 1.0e-6);
    float2 Oct = N.xy;
    if (N.z < 0.0)
    {
        Oct = float2(
            (1.0 - abs(N.y)) * (N.x >= 0.0 ? 1.0 : -1.0),
            (1.0 - abs(N.x)) * (N.y >= 0.0 ? 1.0 : -1.0));
    }
    return saturate(Oct * 0.5 + 0.5);
}

// Decodes full-sphere octahedral UV coordinates in [0, 1]^2 back to a 3D unit direction vector.
float3 V3D_HemiOctahedronToDir(float2 UV)
{
    float2 Oct = UV * 2.0 - 1.0;
    float3 Dir = float3(Oct.x, Oct.y, 1.0 - abs(Oct.x) - abs(Oct.y));
    if (Dir.z < 0.0)
    {
        float OldX = Dir.x;
        Dir.x = (1.0 - abs(Dir.y)) * (OldX >= 0.0 ? 1.0 : -1.0);
        Dir.y = (1.0 - abs(OldX)) * (Dir.y >= 0.0 ? 1.0 : -1.0);
    }
    float LenSq = dot(Dir, Dir);
    return LenSq > 1.0e-8 ? Dir * rsqrt(LenSq) : float3(0.0, 0.0, 1.0);
}

// Computes camera-facing billboard offset in INSTANCE LOCAL SPACE (recommended for HISM/ISM & StaticMesh).
// Automatically preserves per-instance world position, rotation, and scale with zero pivot drift.
// Feed the returned vector through TransformVector(Local -> World) into WorldPositionOffset.
// LocalUV: vertex UV0 in [0,1]^2.
// LocalPosition: vertex local position (UE LocalPosition node).
// ImpostorCenter: baked ImpostorCenter vector parameter (local bounding-sphere center).
// LocalViewDir: camera-to-object direction transformed into Local Space (normalize(TransformVector(World->Local, CameraPos - WorldPos))).
// ImpostorRadius: baked ImpostorRadius scalar parameter (local bounding-sphere radius).
float3 V3D_ImpostorBillboardLocalWPO(
    float2 LocalUV,
    float3 LocalPosition,
    float3 ImpostorCenter,
    float3 LocalViewDir,
    float ImpostorRadius)
{
    float LenSq = dot(LocalViewDir, LocalViewDir);
    float3 Forward = LenSq > 1.0e-6 ? LocalViewDir * rsqrt(LenSq) : float3(1.0, 0.0, 0.0);

    float3 LocalUp = abs(Forward.z) < 0.995 ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0);
    float3 Right = normalize(cross(LocalUp, Forward));
    float3 Up = normalize(cross(Forward, Right));

    float SafeRadius = clamp(ImpostorRadius, 1.0, 100000.0);
    float2 Centered = (LocalUV - 0.5) * 2.0;
    float3 TargetLocalPos = ImpostorCenter + (Right * Centered.x - Up * Centered.y) * SafeRadius;
    return TargetLocalPos - LocalPosition;
}

// World-space billboard fallback (clamped to prevent HISM component-origin stretch).
float3 V3D_ImpostorBillboardWPO(
    float2 LocalUV,
    float3 ObjectCenterWS,
    float3 CameraPosWS,
    float3 CurrentWorldPos,
    float RadiusWS)
{
    float3 ToCam = CameraPosWS - ObjectCenterWS;
    float DistSq = dot(ToCam, ToCam);
    float3 Forward = DistSq > 1.0e-6 ? ToCam * rsqrt(DistSq) : float3(1.0, 0.0, 0.0);

    float3 WorldUp = abs(Forward.z) < 0.995 ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0);
    float3 Right = normalize(cross(WorldUp, Forward));
    float3 Up = normalize(cross(Forward, Right));

    float SafeRadius = clamp(RadiusWS, 1.0, 100000.0);
    float2 Centered = (LocalUV - 0.5) * 2.0;
    float3 TargetPosWS = ObjectCenterWS + (Right * Centered.x - Up * Centered.y) * SafeRadius;
    float3 Offset = TargetPosWS - CurrentWorldPos;
    float OffsetLenSq = dot(Offset, Offset);
    float MaxOffset = SafeRadius * 2.5;
    if (OffsetLenSq > MaxOffset * MaxOffset)
    {
        return float3(0.0, 0.0, 0.0);
    }
    return Offset;
}

// Computes 3-frame barycentric octahedral cell indices and blend weights for smooth view interpolation.
void V3D_ImpostorOctahedralGrid(
    float3 LocalViewDir,
    float GridFrames,
    out float2 Frame0,
    out float2 Frame1,
    out float2 Frame2,
    out float3 Weights)
{
    float SafeFrames = max(floor(GridFrames), 2.0);
    float2 OctUV = V3D_DirToHemiOctahedron(LocalViewDir);
    float2 GridPos = OctUV * (SafeFrames - 1.0);
    float2 BaseCell = floor(GridPos);
    float2 Frac = GridPos - BaseCell;

    float2 MaxCell = float2(SafeFrames - 1.0, SafeFrames - 1.0);
    Frame0 = clamp(BaseCell, 0.0, MaxCell);
    bool bUpperTri = (Frac.x + Frac.y) <= 1.0;

    if (bUpperTri)
    {
        Frame1 = clamp(BaseCell + float2(1.0, 0.0), 0.0, MaxCell);
        Frame2 = clamp(BaseCell + float2(0.0, 1.0), 0.0, MaxCell);
        Weights = float3(1.0 - Frac.x - Frac.y, Frac.x, Frac.y);
    }
    else
    {
        Frame1 = clamp(BaseCell + float2(1.0, 0.0), 0.0, MaxCell);
        Frame2 = clamp(BaseCell + float2(0.0, 1.0), 0.0, MaxCell);
        Frame0 = clamp(BaseCell + float2(1.0, 1.0), 0.0, MaxCell);
        Weights = float3(Frac.x + Frac.y - 1.0, 1.0 - Frac.y, 1.0 - Frac.x);
    }
    Weights = max(Weights, 0.0);
    Weights /= max(Weights.x + Weights.y + Weights.z, 1.0e-6);
}

// Samples a 2-slice Texture2DArray impostor atlas (Slice 0: BaseColor+Alpha, Slice 1: WorldNormal+Roughness).
// Returns float4x3:
//   [0] = Linear BaseColor (RGB)
//   [1] = World/Object-space Normal (RGB, normalized)
//   [2] = float3(Opacity, Roughness, Metallic)
//   [3] = float3(0, 0, 0)
float4x3 V3D_SampleImpostorArray(
    Texture2DArray ImpostorAtlasArray,
    SamplerState ImpostorAtlasArraySampler,
    float2 LocalUV,
    float3 LocalViewDir,
    float GridFrames)
{
    float SafeFrames = max(floor(GridFrames), 2.0);
    float InvFrames = 1.0 / SafeFrames;

    float2 F0, F1, F2;
    float3 W;
    V3D_ImpostorOctahedralGrid(LocalViewDir, SafeFrames, F0, F1, F2, W);

    // Build the billboard's local tangent plane (matches V3D_ImpostorWPO_VS verbatim),
    // then reproject the billboard point onto each blended cell's baked camera plane (Right_i, Up_i).
    // This eliminates 90-180 deg roll jumps on nodes rotated around X/Y whose local +-Z is horizontal.
    float VLenSq = dot(LocalViewDir, LocalViewDir);
    float3 ViewFwd = VLenSq > 1.0e-6 ? LocalViewDir * rsqrt(VLenSq) : float3(1.0, 0.0, 0.0);
    float3 ViewUpRef = abs(ViewFwd.z) < 0.995 ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0);
    float3 ViewRight = normalize(cross(ViewUpRef, ViewFwd));
    float3 ViewUp = normalize(cross(ViewFwd, ViewRight));
    float2 QuadCoord = (saturate(LocalUV) - 0.5) * 2.0;
    float3 BillboardLocalPos = ViewRight * QuadCoord.x - ViewUp * QuadCoord.y;

    float InvGridSpan = rcp(max(SafeFrames - 1.0, 1.0));
    float3 Dir0 = V3D_HemiOctahedronToDir(F0 * InvGridSpan);
    float3 UpRef0 = abs(Dir0.z) < 0.995 ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0);
    float3 Right0 = normalize(cross(UpRef0, Dir0));
    float3 Up0 = normalize(cross(Dir0, Right0));
    float2 CellUV0 = clamp(float2(dot(BillboardLocalPos, Right0) * 0.5 + 0.5, -dot(BillboardLocalPos, Up0) * 0.5 + 0.5), 0.004, 0.996) * InvFrames;

    float3 Dir1 = V3D_HemiOctahedronToDir(F1 * InvGridSpan);
    float3 UpRef1 = abs(Dir1.z) < 0.995 ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0);
    float3 Right1 = normalize(cross(UpRef1, Dir1));
    float3 Up1 = normalize(cross(Dir1, Right1));
    float2 CellUV1 = clamp(float2(dot(BillboardLocalPos, Right1) * 0.5 + 0.5, -dot(BillboardLocalPos, Up1) * 0.5 + 0.5), 0.004, 0.996) * InvFrames;

    float3 Dir2 = V3D_HemiOctahedronToDir(F2 * InvGridSpan);
    float3 UpRef2 = abs(Dir2.z) < 0.995 ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0);
    float3 Right2 = normalize(cross(UpRef2, Dir2));
    float3 Up2 = normalize(cross(Dir2, Right2));
    float2 CellUV2 = clamp(float2(dot(BillboardLocalPos, Right2) * 0.5 + 0.5, -dot(BillboardLocalPos, Up2) * 0.5 + 0.5), 0.004, 0.996) * InvFrames;

    float2 UV0 = F0 * InvFrames + CellUV0;
    float2 UV1 = F1 * InvFrames + CellUV1;
    float2 UV2 = F2 * InvFrames + CellUV2;

#if PIXELSHADER
    float2 DdxUV = ddx(LocalUV) * InvFrames;
    float2 DdyUV = ddy(LocalUV) * InvFrames;

    float4 C0 = ImpostorAtlasArray.SampleGrad(ImpostorAtlasArraySampler, float3(UV0, 0.0), DdxUV, DdyUV);
    float4 C1 = ImpostorAtlasArray.SampleGrad(ImpostorAtlasArraySampler, float3(UV1, 0.0), DdxUV, DdyUV);
    float4 C2 = ImpostorAtlasArray.SampleGrad(ImpostorAtlasArraySampler, float3(UV2, 0.0), DdxUV, DdyUV);

    float4 N0 = ImpostorAtlasArray.SampleGrad(ImpostorAtlasArraySampler, float3(UV0, 1.0), DdxUV, DdyUV);
    float4 N1 = ImpostorAtlasArray.SampleGrad(ImpostorAtlasArraySampler, float3(UV1, 1.0), DdxUV, DdyUV);
    float4 N2 = ImpostorAtlasArray.SampleGrad(ImpostorAtlasArraySampler, float3(UV2, 1.0), DdxUV, DdyUV);
#else
    // Ray Tracing Hit Group shaders lack 2x2 pixel quads (ddx/ddy are illegal in DXC/SM6).
    float4 C0 = ImpostorAtlasArray.SampleLevel(ImpostorAtlasArraySampler, float3(UV0, 0.0), 0.0);
    float4 C1 = ImpostorAtlasArray.SampleLevel(ImpostorAtlasArraySampler, float3(UV1, 0.0), 0.0);
    float4 C2 = ImpostorAtlasArray.SampleLevel(ImpostorAtlasArraySampler, float3(UV2, 0.0), 0.0);

    float4 N0 = ImpostorAtlasArray.SampleLevel(ImpostorAtlasArraySampler, float3(UV0, 1.0), 0.0);
    float4 N1 = ImpostorAtlasArray.SampleLevel(ImpostorAtlasArraySampler, float3(UV1, 1.0), 0.0);
    float4 N2 = ImpostorAtlasArray.SampleLevel(ImpostorAtlasArraySampler, float3(UV2, 1.0), 0.0);
#endif

    float Alpha = C0.a * W.x + C1.a * W.y + C2.a * W.z;
    float3 ColorSum = C0.rgb * (C0.a * W.x) + C1.rgb * (C1.a * W.y) + C2.rgb * (C2.a * W.z);
    float3 BaseColor = Alpha > 1.0e-4 ? (ColorSum / Alpha) : (C0.rgb * W.x + C1.rgb * W.y + C2.rgb * W.z);

    float3 NormalSum = (N0.rgb * 2.0 - 1.0) * (C0.a * W.x)
        + (N1.rgb * 2.0 - 1.0) * (C1.a * W.y)
        + (N2.rgb * 2.0 - 1.0) * (C2.a * W.z);
    float NormalLenSq = dot(NormalSum, NormalSum);
    float3 NormalOS = NormalLenSq > 1.0e-8 ? NormalSum * rsqrt(NormalLenSq) : float3(0.0, 0.0, 1.0);
    float Roughness = saturate(N0.a * W.x + N1.a * W.y + N2.a * W.z);

    float4x3 Out;
    Out[0] = max(BaseColor, 0.0);
    Out[1] = NormalOS;
    Out[2] = float3(saturate(Alpha), Roughness, 0.0);
    Out[3] = float3(0.0, 0.0, 0.0);
    return Out;
}

// Full Vertex-Shader / RT-WPO Compute entry point for UE5 Custom node (WorldPositionOffset).
// Handles StaticMesh, ISM/HISM per-instance transforms, rotation/scale, and LWC automatically.
float3 V3D_ImpostorWPO_VS(
    FMaterialVertexParameters Parameters,
    float3 ImpostorCenter,
    float ImpostorRadius)
{
    float3 LocalPos = Parameters.PreSkinnedPosition;
#if NUM_MATERIAL_TEXCOORDS_VERTEX > 0
    float2 LocalUV = Parameters.TexCoords[0].xy;
#else
    // Derive corner UV directly from local vertex position when no TexCoord node is wired to the WPO graph.
    // Works for both YZ (+X forward, +Z up) and XZ (-Y forward, +Z up) planes without collapsing to 0x0.
    float3 RelPos = LocalPos - ImpostorCenter;
    float HorizCoord = (abs(RelPos.y) >= abs(RelPos.x)) ? RelPos.y : RelPos.x;
    float2 LocalUV = float2(HorizCoord >= 0.0 ? 1.0 : 0.0, RelPos.z >= 0.0 ? 0.0 : 1.0);
#endif

    // Basis vectors of this instance in world space (works identically for StaticMesh, ISM, and HISM).
    float3 AxisX = TransformLocalVectorToWorld(Parameters, float3(1.0, 0.0, 0.0));
    float3 AxisY = TransformLocalVectorToWorld(Parameters, float3(0.0, 1.0, 0.0));
    float3 AxisZ = TransformLocalVectorToWorld(Parameters, float3(0.0, 0.0, 1.0));

    // Derive this instance's ImpostorCenter in Translated World Space (pure float3, LWC-safe).
    float3 DeltaLocal = ImpostorCenter - LocalPos;
    float3 DeltaWS = AxisX * DeltaLocal.x + AxisY * DeltaLocal.y + AxisZ * DeltaLocal.z;
    float3 CenterTWS = Parameters.WorldPosition + DeltaWS;

    // Exact 3x3 adjugate inverse of [AxisX, AxisY, AxisZ] so arbitrary rotations,
    // non-uniform scales, parent-child shear, and negative mirrors map accurately to local space.
    float3 ViewDirWS = ResolvedView.TranslatedWorldCameraOrigin - CenterTWS;
    float3 CofX = cross(AxisY, AxisZ);
    float3 CofY = cross(AxisZ, AxisX);
    float3 CofZ = cross(AxisX, AxisY);
    float Det = dot(AxisX, CofX);
    float InvDet = abs(Det) > 1.0e-8 ? rcp(Det) : 1.0;
    float3 LocalForward = float3(
        dot(ViewDirWS, CofX),
        dot(ViewDirWS, CofY),
        dot(ViewDirWS, CofZ)) * InvDet;
    float LFwdLenSq = dot(LocalForward, LocalForward);
    LocalForward = LFwdLenSq > 1.0e-8 ? LocalForward * rsqrt(LFwdLenSq) : float3(1.0, 0.0, 0.0);

    // Build billboard quad in the exact local space used by CaptureOctahedralAtlas, then map
    // (TargetLocal - LocalPos) directly through the instance's (AxisX, AxisY, AxisZ) matrix.
    // This guarantees 1:1 transform parity with the real mesh and eliminates LWC precision loss.
    float3 LocalUpRef = abs(LocalForward.z) < 0.995 ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0);
    float3 LocalRight = normalize(cross(LocalUpRef, LocalForward));
    float3 LocalUp = normalize(cross(LocalForward, LocalRight));

    float SafeRadius = clamp(ImpostorRadius, 1.0, 100000.0);
    float2 Centered = (LocalUV - 0.5) * 2.0;
    float3 TargetLocal = ImpostorCenter + (LocalRight * Centered.x - LocalUp * Centered.y) * SafeRadius;
    float3 OffsetLocal = TargetLocal - LocalPos;

    return AxisX * OffsetLocal.x + AxisY * OffsetLocal.y + AxisZ * OffsetLocal.z;
}

// Computes normalized camera-to-instance direction in Instance Local Space for Pixel Shader.
// Uses vertex-interpolated Parameters.TangentToWorld so HISM/ISM per-instance rotations are
// always exact on every GPU/RHI path (BuildBillboardQuadMesh authors Normal=+X, Tangent=+Y, BiTangent=+Z).
float3 V3D_ImpostorLocalViewDir_PS(FMaterialPixelParameters Parameters)
{
    float3 AxisX = Parameters.TangentToWorld[2];
    float3 AxisY = Parameters.TangentToWorld[0];
    float3 AxisZ = Parameters.TangentToWorld[1];
    float3 V = Parameters.CameraVector;
    float3 CofX = cross(AxisY, AxisZ);
    float3 CofY = cross(AxisZ, AxisX);
    float3 CofZ = cross(AxisX, AxisY);
    float Det = dot(AxisX, CofX);
    float InvDet = abs(Det) > 1.0e-8 ? rcp(Det) : 1.0;
    float3 LocalViewDir = float3(
        dot(V, CofX),
        dot(V, CofY),
        dot(V, CofZ)) * InvDet;
    float LenSq = dot(LocalViewDir, LocalViewDir);
    return LenSq > 1.0e-8 ? LocalViewDir * rsqrt(LenSq) : float3(1.0, 0.0, 0.0);
}

// Full Pixel-Shader entry point for UE5 Custom node.
// Samples ImpostorAtlasArray using UV0 and instance-local view direction, returning:
//   [0] = Linear BaseColor (RGB)
//   [1] = World-Space Normal (RGB, normalized)
//   [2] = float3(Opacity, Roughness, Metallic)
//   [3] = float3(0, 0, 0)
float4x3 V3D_SampleImpostorArray_PS(
    FMaterialPixelParameters Parameters,
    Texture2DArray ImpostorAtlasArray,
    SamplerState ImpostorAtlasArraySampler,
    float GridFrames,
    float2 LocalUV)
{
    float3 AxisX = Parameters.TangentToWorld[2];
    float3 AxisY = Parameters.TangentToWorld[0];
    float3 AxisZ = Parameters.TangentToWorld[1];
    float3 LocalViewDir = V3D_ImpostorLocalViewDir_PS(Parameters);
    float4x3 Sampled = V3D_SampleImpostorArray(
        ImpostorAtlasArray,
        ImpostorAtlasArraySampler,
        LocalUV,
        LocalViewDir,
        GridFrames);
    float3 NormalWS = AxisX * Sampled[1].x + AxisY * Sampled[1].y + AxisZ * Sampled[1].z;
    float NLenSq = dot(NormalWS, NormalWS);
    Sampled[1] = NLenSq > 1.0e-8 ? NormalWS * rsqrt(NLenSq) : float3(0.0, 0.0, 1.0);
    return Sampled;
}

float4x3 V3D_SampleImpostorArray_PS(
    FMaterialPixelParameters Parameters,
    Texture2DArray ImpostorAtlasArray,
    SamplerState ImpostorAtlasArraySampler,
    float GridFrames)
{
    float2 LocalUV = float2(0.5, 0.5);
#if NUM_TEX_COORD_INTERPOLATORS > 0
    LocalUV = Parameters.TexCoords[0].xy;
#endif
    return V3D_SampleImpostorArray_PS(
        Parameters,
        ImpostorAtlasArray,
        ImpostorAtlasArraySampler,
        GridFrames,
        LocalUV);
}

#endif // V3D_IMPOSTOR_HLSL_INCLUDED
