// V3D terrain shading contract, revision 1.
// Engine-independent HLSL (pixel stage, Shader Model 5 or equivalent).
// Unreal includes the byte-identical v3d.ush alias generated by V3DSimulator.Build.cs.
// Each texture is a Texture2DArray with FOUR equally sized slices. Source factors
// are already baked into the pixels. Base color/emissive use their declared sRGB
// view; normals and ORM MUST use a linear view. Normal pixels contain RGB UNORM
// tangent-space normals (not BC5, DXT5nm, or Unreal's unpacked Normal sampler).
// Vertex RGBA stores layer WEIGHTS, never an interpolated material index.
#ifndef V3D_TERRAIN_HLSL_INCLUDED
#define V3D_TERRAIN_HLSL_INCLUDED

float4 V3D_NormalizeTerrainWeights(float4 VertexWeights)
{
    float4 W = max(VertexWeights, 0.0);
    float Sum = dot(W, float4(1.0, 1.0, 1.0, 1.0));
    return Sum > 1.0e-6 ? W / max(Sum, 1.0e-6) : float4(1.0, 0.0, 0.0, 0.0);
}

float3 V3D_NormalizeTerrainNormal(float3 N)
{
    float LengthSquared = dot(N, N);
    return LengthSquared > 1.0e-8
        ? N * rsqrt(max(LengthSquared, 1.0e-8)) : float3(0.0, 0.0, 1.0);
}

// Useful for previewing baked RGBA weights. Alpha is layer 3, not opacity.
float3 V3D_TerrainWeightDebug(float4 VertexWeights)
{
    float4 W = V3D_NormalizeTerrainWeights(VertexWeights);
    return W.rgb + W.a * float3(1.0, 1.0, 0.0);
}

// Returns linear base color. Additional outputs: tangent-space normal,
// ORM=(occlusion, roughness, metallic), and linear emissive color.
// Pass the texture object's generated sampler explicitly from a UE Custom node.
// Pixel-only: UV derivatives give every array slice consistent mip selection.
// Do not call this function from World Position Offset or a vertex shader.
float4x3 V3D_SampleTerrain(
    Texture2DArray BaseColorArray, SamplerState BaseColorArraySampler,
    Texture2DArray NormalArray, SamplerState NormalArraySampler,
    Texture2DArray ORMArray, SamplerState ORMArraySampler,
    Texture2DArray EmissiveArray, SamplerState EmissiveArraySampler,
    float2 UV, float4 VertexWeights)
{
    float4 W = V3D_NormalizeTerrainWeights(VertexWeights);
    float2 DdxUV = ddx(UV);
    float2 DdyUV = ddy(UV);
    float3 BaseColor = float3(0.0, 0.0, 0.0);
    float3 NormalSum = float3(0.0, 0.0, 0.0);
    float3 ORM = float3(0.0, 0.0, 0.0);
    float3 Emissive = float3(0.0, 0.0, 0.0);

    // Always sample all four layers. No divergent derivative-dependent sampling
    // is introduced by weight boundaries; zero-weight layers contribute zero.
    [unroll]
    for (int Layer = 0; Layer < 4; ++Layer)
    {
        float3 UVLayer = float3(UV, float(Layer));
        float Weight = W[Layer];
        BaseColor += Weight * BaseColorArray.SampleGrad(
            BaseColorArraySampler, UVLayer, DdxUV, DdyUV).rgb;
        float3 N = NormalArray.SampleGrad(
            NormalArraySampler, UVLayer, DdxUV, DdyUV).xyz * 2.0 - 1.0;
        NormalSum += Weight * V3D_NormalizeTerrainNormal(N);
        ORM += Weight * ORMArray.SampleGrad(
            ORMArraySampler, UVLayer, DdxUV, DdyUV).rgb;
        Emissive += Weight * EmissiveArray.SampleGrad(
            EmissiveArraySampler, UVLayer, DdxUV, DdyUV).rgb;
    }

    float3 NormalTS = V3D_NormalizeTerrainNormal(NormalSum);
    ORM = saturate(ORM);
    float4x3 Result;
    Result[0] = max(BaseColor, 0.0);
    Result[1] = NormalTS;
    Result[2] = ORM;
    Result[3] = Emissive;
    return Result;
    //return max(BaseColor, 0.0);
}

#endif // V3D_TERRAIN_HLSL_INCLUDED
